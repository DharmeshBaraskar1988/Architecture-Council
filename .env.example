# Copy to .env and fill in at least two providers.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
# Ollama cloud (free plan models: nemotron-3-*, gemma4:31b, gpt-oss); key at https://ollama.com/settings/keys
OLLAMA_API_KEY=
OLLAMA_API_BASE=https://ollama.com
# Optional: observability (Langfuse, self-hosted or cloud). Also: pip install -e ".[observability]"
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
# Optional: GitHub token for the gate verifier (60 API calls an hour without one; enough for the catalog)
GITHUB_TOKEN=
# PostgreSQL, for when the database server runs (Docker). Phase 1 uses SQLite in data/council.db.
DATABASE_URL=postgresql://council:council@localhost:5432/council
# Tests only: 1 swaps every model call for registered mock responders. Keep 0 for real runs.
COUNCIL_MOCK_LLM=0
